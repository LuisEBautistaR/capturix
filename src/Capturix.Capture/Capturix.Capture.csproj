<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Capturix.Capture</RootNamespace>
    <AssemblyName>Capturix</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\logo\capturix.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tray icon, loaded at the size Windows asks for. -->
    <EmbeddedResource Include="..\..\assets\logo\capturix.ico" LogicalName="Capturix.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Capturix.Core\Capturix.Core.csproj" />
    <ProjectReference Include="..\Capturix.Ocr\Capturix.Ocr.csproj" />
  </ItemGroup>

</Project>
